# Copy to web/.env.local (git-ignored). All values here are public by design:
# they end up in the browser. Never put a secret or service-role key here.

# v2 API (local: run it from api/, see api/README.md)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase project URL + PUBLISHABLE key (used for sign-in from #30 on)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
