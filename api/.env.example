# Copy to api/.env and adjust. api/.env is git-ignored: never commit real values.

# Website origins allowed to call the API (JSON list)
GOPALAN_ALLOWED_ORIGINS=["http://localhost:8080","https://gopalanai.netlify.app"]
# Extra origins as a regular expression (Netlify deploy previews)
GOPALAN_ALLOWED_ORIGIN_REGEX=https://deploy-preview-\d+--gopalanai\.netlify\.app

# Upload limits
GOPALAN_MAX_UPLOAD_MB=10
GOPALAN_MAX_IMAGE_PIXELS=40000000

# Models
GOPALAN_LOAD_MODELS=true
GOPALAN_DETECTION_THRESHOLD=0.5
GOPALAN_BREED_MODEL_PATH=models/breed_classifier.onnx
GOPALAN_BREED_LABELS_PATH=models/labels.json
