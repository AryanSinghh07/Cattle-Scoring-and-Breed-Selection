# Copy to api/.env and adjust. api/.env is git-ignored: never commit real values.

# Website origins allowed to call the API (JSON list)
GOPALAN_ALLOWED_ORIGINS=["http://localhost:8080","https://gopalanai.netlify.app"]
# Extra origins as a regular expression (Netlify deploy previews)
GOPALAN_ALLOWED_ORIGIN_REGEX=https://deploy-preview-\d+--gopalanai\.netlify\.app

# Upload limits
GOPALAN_MAX_UPLOAD_MB=10
GOPALAN_MAX_IMAGE_PIXELS=40000000

# Models
GOPALAN_LOAD_MODELS=true
GOPALAN_DETECTION_THRESHOLD=0.5
GOPALAN_BREED_MODEL_PATH=models/breed_classifier.onnx
GOPALAN_BREED_LABELS_PATH=models/labels.json
# Used when the files above don't exist (e.g. on the Hugging Face Space)
GOPALAN_BREED_MODEL_REPO=thearyansingh/cattle-breed-classifier
GOPALAN_BREED_CROP_TO_ANIMAL=true

# Supabase (saving animals and analyses). Only the project URL and the
# PUBLISHABLE key are needed: the API acts with each user's own login token,
# so the database security rules apply. Never put the secret/service-role key here.
GOPALAN_SUPABASE_URL=https://<project-ref>.supabase.co
GOPALAN_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
GOPALAN_PHOTO_BUCKET=animal-photos
GOPALAN_PHOTO_MAX_SIDE=2048
GOPALAN_SIGNED_URL_SECONDS=3600

# In-memory side photos for /recompute (never written to disk)
GOPALAN_CACHE_TTL_MINUTES=30
GOPALAN_CACHE_MAX_ENTRIES=32
GOPALAN_CACHE_MAX_SIDE=1600
